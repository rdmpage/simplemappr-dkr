# SimpleMappr Docker Environment Configuration
# Copy this file to .env and adjust values for your environment

# Options: development, production
ENVIRONMENT=development

# Port to expose the app on
APP_PORT=8080

# Google Analytics 4 Measurement ID (optional, e.g. G-XXXXXXXXXX)
# Leave empty to disable analytics
GA_MEASUREMENT_ID=

# Google Tag Manager container ID (optional, e.g. GTM-XXXXXXX)
# Leave empty to disable. Map downloads are pushed to the dataLayer
# as a "file_download" event for use as a GTM trigger.
GTM_CONTAINER_ID=
